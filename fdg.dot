digraph FDG {
  node [shape=box, style="filled,rounded", fillcolor="#E6F4EA", color="#137333", fontname="Segoe UI", penwidth=1.5];
  edge [color="#137333", fontname="Segoe UI", penwidth=1.5];
  n1 [label="1: START"];
  n9 [label="9: Asignacion: x = 0"];
  n8 [label="8: Asignacion: y = 0"];
  n7 [label="7: Asignacion: z = 0"];
  n4 [label="4: While (y < 10)"];
  n6 [label="6: Asignacion: z = z + 1"];
  n5 [label="5: Asignacion: y = y + 1"];
  n3 [label="3: Return z"];
  n1 -> n9;
  n1 -> n8;
  n1 -> n7;
  n1 -> n4;
  n8 -> n4;
  n5 -> n4;
  n6 -> n6;
  n7 -> n6;
  n8 -> n5;
  n5 -> n5;
  n1 -> n3;
  n6 -> n3;
  n7 -> n3;
}
