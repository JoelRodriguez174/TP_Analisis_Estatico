digraph PDT {
  node [shape=ellipse, fontname="Consolas", style=filled, color=lightgreen];
  n1 [label="1: START"];
  n2 [label="2: EXIT"];
  n3 [label="3: Return z"];
  n4 [label="4: While (y < 10)"];
  n5 [label="5: Asignacion: y = y + 1"];
  n6 [label="6: Asignacion: z = z + 1"];
  n7 [label="7: Asignacion: z = 0"];
  n8 [label="8: Asignacion: y = 0"];
  n9 [label="9: Asignacion: x = 0"];
  n9 -> n1;
  n2 -> n3;
  n3 -> n4;
  n4 -> n5;
  n5 -> n6;
  n4 -> n7;
  n7 -> n8;
  n8 -> n9;
}
