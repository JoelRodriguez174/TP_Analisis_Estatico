digraph CFG {
  node [shape=box, fontname="Consolas"];
  n1 [label="1: START\nPDOM: {4,2,1,8,9,7,3}"];
  n2 [label="2: EXIT\nPDOM: {2}"];
  n3 [label="3: Return z\nPDOM: {2,3}"];
  n4 [label="4: While (y < 10)\nPDOM: {4,2,3}"];
  n5 [label="5: Asignacion: y = y + 1\nPDOM: {4,2,3,5}"];
  n6 [label="6: Asignacion: z = z + 1\nPDOM: {4,2,6,3,5}"];
  n7 [label="7: Asignacion: z = 0\nPDOM: {4,2,7,3}"];
  n8 [label="8: Asignacion: y = 0\nPDOM: {4,2,8,7,3}"];
  n9 [label="9: Asignacion: x = 0\nPDOM: {4,2,8,9,7,3}"];
  n1 -> n9;
  n3 -> n2;
  n4 -> n6;
  n4 -> n3;
  n5 -> n4;
  n6 -> n5;
  n7 -> n4;
  n8 -> n7;
  n9 -> n8;
}
