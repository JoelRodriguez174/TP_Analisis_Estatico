  n1 -> n7 [color="#DADCE0", label="DD", fontcolor="#BCC1C6", penwidth=0.8];
  n1 -> n4 [color="#137333", label="DD", fontcolor="#137333", penwidth=3.0];
  n8 -> n4 [color="#137333", label="DD", fontcolor="#137333", penwidth=3.0];
  n5 -> n4 [color="#137333", label="DD", fontcolor="#137333", penwidth=3.0];
  n6 -> n6 [color="#DADCE0", label="DD", fontcolor="#BCC1C6", penwidth=0.8];
  n7 -> n6 [color="#DADCE0", label="DD", fontcolor="#BCC1C6", penwidth=0.8];
  n8 -> n5 [color="#137333", label="DD", fontcolor="#137333", penwidth=3.0];
