  n4 -> n6 [color="#DADCE0", label="CD", fontcolor="#BCC1C6", penwidth=0.8];
  n4 -> n5 [color="#1A73E8", label="CD", fontcolor="#1A73E8", penwidth=3.0];
  n1 -> n3 [color="#DADCE0", label="CD", fontcolor="#BCC1C6", penwidth=0.8];
  n1 -> n9 [color="#DADCE0", label="DD", fontcolor="#BCC1C6", penwidth=0.8];
